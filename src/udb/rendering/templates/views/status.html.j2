{% from "views/_macros.html.j2" import pill %}
<h2 class="sr-only">Estado de cada clase por materia y el siguiente paso.</h2>
{% for s in subjects %}
<div style="background:var(--surface-2);border:0.5px solid var(--border);border-radius:12px;padding:1rem 1.25rem;margin-bottom:12px">
  <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
    <span style="font-weight:500">{{ s.code }}</span><span style="color:var(--text-secondary);font-size:14px">{{ s.name }}</span>
    <span style="flex:1"></span>
    <span style="font-size:13px;color:var(--text-secondary)">{{ s.summary.get('complete', 0) }}/{{ s.classes | length }} completas</span>
  </div>
  {% if s.classes %}
  <div style="display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 4px">
    {% for r in s.classes %}
    <span title="{{ stage_es[r.stage] }}{% if r.title %} · {{ r.title }}{% endif %}{% if r.material_covered is not none %} · material cubierto {{ r.material_covered }}%{% endif %}" style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:28px;border-radius:var(--radius);font-size:12px;{% set t = stage_tone[r.stage] %}{% if t == 'neutral' %}background:var(--surface-1);color:var(--text-muted);{% else %}background:var(--bg-{{ t }});color:var(--text-{{ t }});{% endif %}">{{ '%02d' % r['class'] }}</span>
    {% endfor %}
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px">
    {% for stage, n in s.summary.items() if n %}{{ pill(stage_es[stage] ~ " · " ~ n, stage_tone[stage]) }}{% endfor %}
  </div>
  {% elif s.hint %}
  <div style="font-size:13px;color:var(--text-secondary);margin-top:6px">{{ s.hint }}</div>
  {% endif %}
  {% if s.next %}
  <div style="display:flex;align-items:center;gap:8px;margin-top:10px;font-size:13px">
    <span style="color:var(--text-secondary)">Siguiente paso</span>
    <code style="font-family:var(--font-mono);font-size:12px">{{ s.next }}</code>
    <span style="flex:1"></span>
    <button onclick="sendPrompt('Haz el siguiente paso de {{ s.code }}: {{ s.next }}')">Hacerlo ↗</button>
  </div>
  {% endif %}
</div>
{% endfor %}
