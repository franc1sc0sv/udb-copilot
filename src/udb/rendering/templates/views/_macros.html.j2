{%- macro pill(text, tone="neutral") -%}
<span style="display:inline-block;font-size:12px;line-height:1.4;padding:2px 8px;border-radius:var(--radius);{% if tone == 'neutral' %}background:var(--surface-1);color:var(--text-secondary);{% else %}background:var(--bg-{{ tone }});color:var(--text-{{ tone }});{% endif %}">{{ text }}</span>
{%- endmacro -%}
{%- macro metric(label, value, sub="") -%}
<div style="background:var(--surface-1);border-radius:var(--radius);padding:12px 14px;min-width:0">
  <div style="font-size:13px;color:var(--text-secondary)">{{ label }}</div>
  <div style="font-size:22px;font-weight:500;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ value }}</div>
  {% if sub %}<div style="font-size:12px;color:var(--text-muted);margin-top:2px">{{ sub }}</div>{% endif %}
</div>
{%- endmacro -%}
{%- macro row_start() -%}<div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-top:0.5px solid var(--border);font-size:14px">{%- endmacro -%}
