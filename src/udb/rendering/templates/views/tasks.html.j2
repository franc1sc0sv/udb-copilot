{% from "views/_macros.html.j2" import pill, row_start %}
<h2 class="sr-only">Tareas: estado en Moodle y carpeta local.</h2>
{% for r in rows %}
{{ row_start() }}
  <span style="min-width:72px">{% if r.days is not none %}{{ pill((r.days ~ " d") if r.days >= 0 else "vencida", tone_for_days(r.days, r.moodle == 'submitted') if r.days >= 0 else ('success' if r.moodle == 'submitted' else 'danger')) }}{% else %}{{ pill("sin fecha") }}{% endif %}</span>
  <span style="font-family:var(--font-mono);font-size:12px;color:var(--text-secondary);min-width:34px">{{ r.subject }}</span>
  <span style="flex:1;min-width:0">{{ r.title }}{% if r.type in ('quiz', 'forum') %}<span style="font-size:12px;color:var(--text-muted)"> · {{ 'examen' if r.type == 'quiz' else 'foro' }}</span>{% endif %}</span>
  {% if r.grade %}{{ pill(r.grade, 'success') }}{% endif %}
  {{ pill(state_es.get(r.moodle, r.moodle), 'success' if r.moodle == 'submitted' else 'neutral') }}
  {{ pill(r.local, 'success' if r.local in ('submitted', 'graded') else 'neutral') }}
</div>
{% endfor %}
