{#- The digest email, designed for a phone: one column, read top to bottom, no side
    columns. Email-safe: tables and inline styles (Gmail drops most CSS).
    Palette after Claude: ivory page, white cards, clay accent, serif headings. -#}
{%- set C = {"page": "#F0EEE6", "card": "#FFFFFF", "line": "#E8E6DC", "ink": "#141413",
             "muted": "#5E5D59", "faint": "#87867F", "clay": "#C15F3C"} -%}
{%- set TONE = {"urgent": ("#B53A2E", "#FBEAE7"), "soon": ("#A86412", "#FBF0DD"),
                "ok": ("#4F6B2E", "#EDF2E4"), "check": ("#7A5C99", "#F1EBF7"),
                "info": ("#2F6290", "#E6EEF7"), "none": ("#5E5D59", "#F0EEE6")} -%}
{%- set PALETTE = [("#C15F3C", "#F9ECE6"), ("#2F6290", "#E6EEF7"), ("#4F6B2E", "#EDF2E4"),
                   ("#7A5C99", "#F1EBF7"), ("#9A6A2F", "#F6EDE0"), ("#2E7A73", "#E3F2F0")] -%}
{%- set GROUPS = [("hoy", "Urgente · hoy", "urgent"), ("mañana", "Mañana", "soon"),
                  ("semana", "Próximos 7 días", "none"), ("revisar", "Para revisar", "check")] -%}
{%- set KIND = {"exam": "examen", "quiz": "examen", "assignment": "entrega", "assign": "entrega",
                "forum": "foro", "project": "proyecto"} -%}
{%- set codes = d.subjects | list -%}
{%- set SERIF = "Georgia,'Times New Roman',serif" -%}
{%- set SANS = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif" -%}

{%- macro chip(code) -%}
{%- set i = codes.index(code) if code in codes else -1 -%}
{%- set col = PALETTE[i % 6] if i >= 0 else ("#5E5D59", "#F0EEE6") -%}
<span style="display:inline-block;padding:1px 8px;border-radius:999px;background:{{ col[1] }};color:{{ col[0] }};font:700 11px/17px {{ SANS }};letter-spacing:.3px;">{{ code or "—" }}</span>
{%- endmacro -%}

{%- macro badge(text, tone) -%}
<span style="display:inline-block;padding:2px 8px;border-radius:6px;background:{{ TONE[tone][1] }};color:{{ TONE[tone][0] }};font:700 11px/15px {{ SANS }};letter-spacing:.5px;text-transform:uppercase;white-space:nowrap;">{{ text }}</span>
{%- endmacro -%}

{%- macro tag(text) -%}
<span style="display:inline-block;padding:0 7px;border-radius:999px;border:1px solid {{ C.line }};color:{{ C.muted }};font:11px/17px {{ SANS }};">{{ text }}</span>
{%- endmacro -%}

{%- macro days_text(days) -%}
{{ "hoy" if days == 0 else "mañana" if days == 1 else "en " ~ days ~ " días" }}
{%- endmacro -%}

{%- macro card_open(title, note="") -%}
<tr><td style="padding:0 0 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ C.card }};border:1px solid {{ C.line }};border-radius:14px;">
<tr><td class="cardpad" style="padding:16px 18px 4px;">
  <div style="font:600 19px/24px {{ SERIF }};color:{{ C.ink }};"><span style="display:inline-block;width:4px;height:17px;background:{{ C.clay }};border-radius:2px;margin-right:9px;vertical-align:-2px;"></span>{{ title }}</div>
  {% if note %}<div style="font:13px/18px {{ SANS }};color:{{ C.faint }};margin-top:3px;">{{ note }}</div>{% endif %}
</td></tr>
<tr><td class="cardpad" style="padding:8px 18px 14px;">
{%- endmacro -%}

{%- macro card_close() -%}
</td></tr></table>
</td></tr>
{%- endmacro -%}

{%- macro link(text, url, color=C.ink) -%}
{% if url %}<a href="{{ url }}" style="color:{{ color }};text-decoration:none;">{{ text }}</a>{% else %}{{ text }}{% endif %}
{%- endmacro -%}

{%- macro sep(first) -%}{{ "" if first else "border-top:1px solid " ~ C.line ~ ";" }}{%- endmacro -%}

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light only">
<title>{{ "Novedades en el aula" if d.mode == "alerts" else "Tu día" }}</title>
<style>
  @media (max-width:520px){
    .outer{padding:12px 6px!important}
    .cardpad{padding-left:14px!important;padding-right:14px!important}
    .big{font-size:27px!important;line-height:32px!important}
  }
</style>
</head>
<body style="margin:0;padding:0;background:{{ C.page }};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ C.page }};">
<tr><td class="outer" align="center" style="padding:20px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">

{#- ------------------------------------------------------------ header #}
{%- set cr = d.classroom -%}
{%- set fresh = cr.updates | selectattr("new") | list -%}
{%- set open = d.countdown | rejectattr("submitted") | list if d.countdown else [] -%}
<tr><td style="padding:4px 8px 16px;">
  <div style="font:700 12px/16px {{ SANS }};color:{{ C.clay }};letter-spacing:1.4px;text-transform:uppercase;">✳ udb · {{ "novedades en el aula" if d.mode == "alerts" else "tu resumen" }}</div>
  <div class="big" style="font:600 30px/36px {{ SERIF }};color:{{ C.ink }};margin-top:6px;">
    {%- if d.mode == "alerts" %}{{ "Algo cambió en tu aula" if (cr.updates or cr.changed_assignments or cr.notifications or cr.announcements or d.mail) else "Tienes entregas pendientes" }}{% else %}{{ d.date | day_month | capitalize }}{% endif -%}
  </div>
  <div style="font:14px/20px {{ SANS }};color:{{ C.muted }};margin-top:4px;">{{ d.date | long_date | capitalize }} · {{ d.generated | clock }}</div>
  {%- if d.mode != "alerts" and (d.classes_today or d.events_today) %}
  <div style="font:13px/22px {{ SANS }};color:{{ C.muted }};margin-top:8px;">
    {%- if d.classes_today %}Clases hoy: {% for c in d.classes_today %}{{ chip(c.code) }} {% endfor %}{% endif %}
    {%- if d.events_today %}{% if d.classes_today %}<br>{% endif %}Tu calendario: {% for e in d.events_today %}<b>{{ e.start | clock }}</b> {{ e.title }}{{ " · " if not loop.last }}{% endfor %}{% endif %}
  </div>
  {%- endif %}
</td></tr>

{#- ------------------------------------------------------------ at a glance #}
{%- if d.mode != "alerts" %}
{%- set today_n = open | selectattr("days", "equalto", 0) | list | length %}
{%- set tomorrow_n = open | selectattr("days", "equalto", 1) | list | length %}
{%- set week_n = open | selectattr("days", "le", 7) | list | length - today_n - tomorrow_n %}
{%- set glance = [(today_n, "cierra hoy" if today_n == 1 else "cierran hoy", "urgent" if today_n else "ok"),
                  (tomorrow_n, "cierra mañana" if tomorrow_n == 1 else "cierran mañana", "soon" if tomorrow_n else "ok"),
                  (week_n, "más en los próximos 7 días", "none"),
                  (fresh | length, "cambios nuevos en Moodle", "info" if fresh else "none"),
                  (cr.notifications | length, "notificaciones sin leer", "check" if cr.notifications else "none")] %}
<tr><td style="padding:0 0 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ C.card }};border:1px solid {{ C.line }};border-radius:14px;">
{%- for n, label, tone in glance %}
<tr><td class="cardpad" style="padding:11px 18px;{{ sep(loop.first) }}">
  <span style="display:inline-block;min-width:34px;font:600 24px/28px {{ SERIF }};color:{{ TONE[tone][0] }};vertical-align:middle;">{{ n }}</span>
  <span style="font:15px/22px {{ SANS }};color:{{ C.ink if n else C.faint }};vertical-align:middle;">{{ label }}</span>
</td></tr>
{%- endfor %}
</table>
</td></tr>
{%- endif %}

{#- ------------------------------------------------------------ next steps, by urgency #}
{%- if d.next_steps %}
{{ card_open("Sin entregar" if d.mode == "alerts" else "Qué hacer ahora", "Cierra en las próximas 24 horas y aún no está entregado. Este aviso se repite hasta que entregues." if d.mode == "alerts" else "Lo que cierra antes va primero; el mismo día, lo que pesa más.") }}
{%- for key, title, tone in GROUPS %}
{%- set steps = d.next_steps | selectattr("group", "equalto", key) | list %}
{%- if steps %}
<div style="margin:{{ '4px' if loop.first else '14px' }} 0 6px;">{{ badge(title, tone) }}</div>
{%- for s in steps %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px;background:{{ TONE[s.tone][1] }};border-left:4px solid {{ TONE[s.tone][0] }};border-radius:10px;">
<tr><td style="padding:12px 14px;">
  <div style="font:600 15px/21px {{ SANS }};color:{{ C.ink }};">{{ s.title }}</div>
  {%- if s.due %}
  <div style="font:13px/20px {{ SANS }};color:{{ C.muted }};margin-top:4px;">{{ s.due | day_month | capitalize }}{% if s.due | clock %}, {{ s.due | clock }}{% endif %}</div>
  <div style="font:700 13px/20px {{ SANS }};color:{{ TONE[s.tone][0] }};">{{ s.due | left | capitalize }}{% if s.weight %}<span style="font-weight:400;color:{{ C.muted }};"> · vale {{ s.weight }}% de la nota</span>{% endif %}</div>
  {%- endif %}
  {%- if s.route_day %}
  <div style="font:13px/20px {{ SANS }};color:{{ C.muted }};margin-top:4px;">Moodle dice <b>{{ s.moodle_day | day_month }}</b>; la ruta de aprendizaje, <b>{{ s.route_day | day_month }}</b>.</div>
  {%- endif %}
  <div style="margin-top:8px;">
    {%- if s.subject %}{{ chip(s.subject) }}&nbsp; {% endif %}
    {%- if s.url %}<a href="{{ s.url }}" style="display:inline-block;padding:5px 12px;border-radius:8px;background:{{ TONE[s.tone][0] }};color:#FFFFFF;font:600 12px/14px {{ SANS }};text-decoration:none;">Abrir</a>{% endif %}
  </div>
</td></tr></table>
{%- endfor %}
{%- endif %}
{%- endfor %}
{{ card_close() }}
{%- endif %}

{#- ------------------------------------------------------------ evaluations #}
{%- if d.mode != "alerts" and d.countdown %}
{{ card_open("Próximas evaluaciones", "Los próximos 45 días, con su peso en la nota.") }}
{%- for i in d.countdown %}
{%- set tone = "ok" if i.submitted else "urgent" if i.days <= 1 else "soon" if i.days <= 3 else "none" %}
<div style="padding:11px 0;{{ sep(loop.first) }}">
  <div>{{ badge("entregada" if i.submitted else days_text(i.days), tone) }}{% if i.weight %}&nbsp; <span style="font:600 14px/18px {{ SERIF }};color:{{ C.ink }};">{{ i.weight }}%</span>{% endif %}</div>
  <div style="font:600 15px/21px {{ SANS }};color:{{ C.ink }};margin-top:6px;">{{ link(i.label, i.url) }}</div>
  <div style="font:13px/20px {{ SANS }};color:{{ C.muted }};margin-top:3px;">{{ chip(i.subject) }}&nbsp; {{ (i.due_ts or i.due) | day_month }}{% if i.due_ts %}, {{ i.due_ts | clock }}{% endif %}{% if KIND.get(i.kind) %} · {{ KIND[i.kind] }}{% endif %}</div>
  {%- if i.route_due %}<div style="font:12px/18px {{ SANS }};color:{{ TONE.check[0] }};margin-top:3px;">La ruta de aprendizaje dice {{ i.route_due | day_month }}</div>{% endif %}
</div>
{%- endfor %}
{{ card_close() }}
{%- endif %}

{#- ------------------------------------------------------------ Moodle calendar as a timeline #}
{%- if d.calendar %}
{{ card_open("Calendario del aula", "Próximas 3 semanas en Moodle, de arriba hacia abajo.") }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
{%- for day, events in d.calendar | groupby("day") %}
{%- set is_today = day == d.date %}
{%- set dot = TONE.urgent[0] if is_today else C.clay %}
<tr>
  <td width="14" valign="top" style="width:14px;border-right:2px solid {{ C.line }};padding-top:{{ '2px' if loop.first else '16px' }};">
    <div style="width:12px;height:12px;border-radius:50%;background:{{ dot }};border:2px solid {{ C.card }};margin-left:6px;"></div>
  </td>
  <td valign="top" style="padding:{{ '0' if loop.first else '14px' }} 0 2px 14px;font:700 12px/18px {{ SANS }};color:{{ dot }};letter-spacing:.8px;text-transform:uppercase;">{{ "Hoy · " if is_today }}{{ day | day_month }}</td>
</tr>
{%- for e in events %}
<tr>
  <td width="14" style="width:14px;border-right:2px solid {{ C.line }};"></td>
  <td valign="top" style="padding:6px 0 6px 14px;">
    <div style="font:700 13px/18px {{ SANS }};color:{{ C.muted }};">{{ e.ts | clock }}</div>
    <div style="font:600 15px/21px {{ SANS }};color:{{ C.ink }};">{{ link(e.name, e.url) }}</div>
    <div style="margin-top:3px;">{{ chip(e.subject) }} {{ tag(e.kind) }}</div>
  </td>
</tr>
{%- endfor %}
{%- endfor %}
</table>
{{ card_close() }}
{%- endif %}

{#- ------------------------------------------------------------ what changed #}
{%- if cr.changed_assignments or cr.updates %}
{{ card_open("Lo que cambió en Moodle", ("En las últimas 2 horas." if d.mode == "alerts" else "Última semana. «Nuevo» no salía en el resumen anterior.")) }}
{%- for u in cr.updates[:15] %}
<div style="padding:10px 0;{{ sep(loop.first) }}">
  {%- if u.new or "grades" in u.changed %}<div style="margin-bottom:5px;">{% if u.new %}{{ badge("nuevo", "urgent") }} {% endif %}{% if "grades" in u.changed %}{{ badge("nota publicada", "ok") }}{% endif %}</div>{% endif %}
  <div style="font:600 15px/21px {{ SANS }};color:{{ C.ink }};">{{ link(u.name, u.url) }}</div>
  <div style="font:12px/22px {{ SANS }};color:{{ C.faint }};margin-top:3px;">{{ chip(u.subject) }}{% for c in u.changed_es %} {{ tag(c) }}{% endfor %}{% if u.ts %} · {{ u.ts | ago }}{% endif %}</div>
</div>
{%- endfor %}
{%- for a in cr.changed_assignments if not (cr.updates | selectattr("url", "equalto", a.url) | list) %}
<div style="padding:10px 0;border-top:1px solid {{ C.line }};">
  <div style="margin-bottom:5px;">{{ badge("editada", "info") }}</div>
  <div style="font:600 15px/21px {{ SANS }};color:{{ C.ink }};">{{ link(a.name, a.url) }}</div>
  <div style="font:12px/20px {{ SANS }};color:{{ C.muted }};margin-top:3px;">{{ chip(a.subject) }}&nbsp; {% if a.due %}vence {{ a.due | day_month }}{% else %}sin fecha de cierre{% endif %}</div>
</div>
{%- endfor %}
{{ card_close() }}
{%- endif %}

{#- ------------------------------------------------------------ notifications #}
{%- if cr.notifications %}
{{ card_open("Notificaciones sin leer") }}
{%- for n in cr.notifications %}
<div style="padding:10px 0;{{ sep(loop.first) }}">
  {%- if n.new %}<div style="margin-bottom:5px;">{{ badge("nuevo", "urgent") }}</div>{% endif %}
  <div style="font:15px/21px {{ SANS }};color:{{ C.ink }};">{{ link(n.subject, n.link) }}</div>
  <div style="font:12px/18px {{ SANS }};color:{{ C.faint }};margin-top:2px;">{{ n.ts | ago }}</div>
</div>
{%- endfor %}
{{ card_close() }}
{%- endif %}

{#- ------------------------------------------------------------ announcements #}
{%- if cr.announcements %}
{{ card_open("Anuncios de los profesores") }}
{%- for a in cr.announcements %}
<div style="padding:10px 0;{{ sep(loop.first) }}">
  <div style="font:600 15px/21px {{ SANS }};color:{{ C.ink }};">{{ a.topic }}</div>
  <div style="font:12px/20px {{ SANS }};color:{{ C.muted }};margin-top:2px;">{{ chip(a.subject) }}&nbsp; {{ a.author }} · {{ a.timestamp | ago }}</div>
  {% if a.text %}<div style="font:14px/20px {{ SANS }};color:{{ C.muted }};margin-top:5px;">{{ a.text }}</div>{% endif %}
</div>
{%- endfor %}
{{ card_close() }}
{%- endif %}

{#- ------------------------------------------------------------ said in class #}
{%- if d.said_in_class %}
{{ card_open("Dicho en clase", "De las grabaciones. Por confirmar hasta que salga en Moodle o en un correo.") }}
{%- for x in d.said_in_class %}
<div style="padding:10px 0;{{ sep(loop.first) }}">
  <div style="font:12px/20px {{ SANS }};color:{{ C.muted }};">{{ chip(x.subject) }}&nbsp; clase del {{ x.class_date | day_month }} · minuto {{ x.t // 60 }}:{{ "%02d" % (x.t % 60) }}</div>
  {%- if x.dates %}<div style="font:700 13px/19px {{ SANS }};color:{{ TONE.soon[0] }};margin-top:2px;">{% for dt in x.dates %}{{ dt | day_month }}{{ ", " if not loop.last }}{% endfor %}</div>{% endif %}
  <div style="font:italic 15px/22px {{ SERIF }};color:{{ C.ink }};margin-top:5px;border-left:3px solid {{ C.line }};padding-left:10px;">«{{ x.quote }}»</div>
</div>
{%- endfor %}
{{ card_close() }}
{%- endif %}

{#- ------------------------------------------------------------ mail #}
{%- if d.mail %}
{{ card_open("Correos", "De profesores y del aula virtual.") }}
{%- for m in d.mail[:10] %}
<div style="padding:10px 0;{{ sep(loop.first) }}">
  <div style="font:600 15px/21px {{ SANS }};color:{{ C.ink }};">{{ link(m.subject or "(sin asunto)", m.link) }}</div>
  <div style="font:12px/18px {{ SANS }};color:{{ C.faint }};margin-top:2px;">{{ m.sender }} · {{ m.date | ago }}</div>
</div>
{%- endfor %}
{{ card_close() }}
{%- endif %}

{#- ------------------------------------------------------------ failed sources + footer #}
{%- set failed = d.sources | rejectattr("ok") | list %}
{%- if failed %}
<tr><td style="padding:0 0 12px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ TONE.soon[1] }};border-left:4px solid {{ TONE.soon[0] }};border-radius:12px;">
  <tr><td style="padding:12px 14px;font:14px/20px {{ SANS }};color:{{ C.ink }};">
    <b>No pude leer:</b> {{ failed | map(attribute="name") | join(", ") }}. Lo que viene de ahí puede faltar.
  </td></tr></table>
</td></tr>
{%- endif %}
<tr><td align="center" style="padding:6px 8px 8px;font:12px/18px {{ SANS }};color:{{ C.faint }};">
  Hecho por udb con datos de Moodle, tu correo y tu calendario, sin inventar nada.<br>
  {{ link("Abrir el aula virtual", d.moodle_url, C.clay) }}
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
