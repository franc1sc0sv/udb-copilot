<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><meta name="color-scheme" content="light"></head>
<body style="margin:0;background:#fbfaf8;color:#1d1c1a;font:15px/1.55 -apple-system,Segoe UI,Roboto,sans-serif;">
<div style="max-width:620px;margin:0 auto;padding:22px 18px;">
{% if d.mode == 'alerts' %}
  <h1 style="font-size:20px;margin:0 0 12px;">Novedades en el aula</h1>
{% else %}
  <h1 style="font-size:20px;margin:0 0 4px;">Buenos días</h1>
  <div style="color:#6b6862;margin-bottom:16px;">Tu día, {{ d.date }}</div>
  {% if d.classes_today %}
  <h2 style="font-size:15px;margin:18px 0 6px;">Clases de hoy</h2>
  <ul style="margin:0;padding-left:18px;">{% for c in d.classes_today %}<li>{{ c.code }} · {{ c.name }}</li>{% endfor %}</ul>
  {% endif %}
  {% if d.events_today %}
  <h2 style="font-size:15px;margin:18px 0 6px;">Calendario</h2>
  <ul style="margin:0;padding-left:18px;">{% for e in d.events_today %}<li>{{ e.title }}</li>{% endfor %}</ul>
  {% endif %}
  {% if d.due_soon %}
  <h2 style="font-size:15px;margin:18px 0 6px;color:#b23a2b;">Vence pronto</h2>
  <ul style="margin:0;padding-left:18px;">{% for i in d.due_soon %}<li><b>{{ i.subject }}</b> · {{ i.label }} · {{ when(i.days) }} ({{ i.due }})</li>{% endfor %}</ul>
  {% endif %}
  {% if d.countdown %}
  <h2 style="font-size:15px;margin:18px 0 6px;">Cuenta regresiva</h2>
  <table style="border-collapse:collapse;width:100%;font-size:14px;">
  {% for i in d.countdown %}
    <tr style="border-bottom:1px solid #e3e0da;">
      <td style="padding:5px 6px;font-weight:600;{{ 'color:#b23a2b;' if i.days <= 3 and not i.submitted }}">{{ i.days }} d</td>
      <td style="padding:5px 6px;">{{ i.subject }}</td>
      <td style="padding:5px 6px;">{{ i.label }}{% if i.weight %} · {{ i.weight }}%{% endif %}</td>
      <td style="padding:5px 6px;color:#4f7a3a;">{{ 'entregada' if i.submitted }}</td>
    </tr>
  {% endfor %}
  </table>
  {% endif %}
{% endif %}
{% if d.classroom.changed_assignments %}
  <h2 style="font-size:15px;margin:18px 0 6px;">Actividades nuevas o cambiadas</h2>
  <ul style="margin:0;padding-left:18px;">{% for a in d.classroom.changed_assignments %}<li><b>{{ a.subject }}</b> · <a href="{{ a.url }}">{{ a.name }}</a> · vence {{ a.due or 'sin fecha' }}</li>{% endfor %}</ul>
{% endif %}
{% if d.classroom.announcements %}
  <h2 style="font-size:15px;margin:18px 0 6px;">Anuncios</h2>
  <ul style="margin:0;padding-left:18px;">{% for a in d.classroom.announcements %}<li><b>{{ a.subject }}</b> · {{ a.topic }} — {{ a.author }}<br><span style="color:#6b6862;">{{ a.text }}</span></li>{% endfor %}</ul>
{% endif %}
{% if d.mail %}
  <h2 style="font-size:15px;margin:18px 0 6px;">Correos</h2>
  <ul style="margin:0;padding-left:18px;">{% for m in d.mail[:15] %}<li>{{ m.sender }}: <b>{{ m.subject }}</b> <span style="color:#6b6862;">({{ m.account }})</span></li>{% endfor %}</ul>
{% endif %}
{% set failed = d.sources | rejectattr('ok') | list %}
{% if failed %}<p style="color:#b9772b;margin-top:18px;">No pude leer: {{ failed | map(attribute='name') | join(', ') }}</p>{% endif %}
<p style="color:#6b6862;font-size:12px;margin-top:24px;">Generado por udb digest.</p>
</div>
</body>
</html>
